# ---------- Server ----------
PORT=4000
NODE_ENV=development

# ---------- Database ----------
# Local dev: leave both empty -> file DB at backend/data/habitgo.db
# Production (hosted, permanent): create a free Turso database (https://turso.tech)
# and put its URL + token here, e.g.:
#   DATABASE_URL=libsql://habitgo-<your-org>.turso.io
#   DATABASE_TOKEN=eyJhbGciOi...
DATABASE_URL=
DATABASE_TOKEN=

# ---------- Auth ----------
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# ---------- CORS ----------
# * = allow all origins (fine for the APK + local dev).
# For a locked-down deployment list them comma-separated — include the native
# app origin or installed builds will break:
#   CORS_ORIGINS=https://my-habitgo.onrender.com,https://localhost
CORS_ORIGINS=*

# ---------- Seed demo accounts ----------
SEED_USER_PASSWORD=Peter@12345
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- Email (SMTP) ----------
# Gmail example in README. Without these the OTP shows in-app (demo mode).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
